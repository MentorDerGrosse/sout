{
  "name": "sout",
  "productName": "sout",
  "version": "0.1.0",
  "description": "Studium an der TU Wien organisieren: TISS-Kalender, TUWEL-Abgaben, Notizen pro Fach",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "desktopName": "sout.desktop",
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform=x11 --lang=de-AT",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --ozone-platform=x11 --lang=de-AT",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false",
    "icons": "node scripts/gen-icons.mjs",
    "install-desktop": "node scripts/install-desktop.mjs",
    "uninstall-desktop": "node scripts/install-desktop.mjs --remove"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@lezer/highlight": "^1.2.5",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.52.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
